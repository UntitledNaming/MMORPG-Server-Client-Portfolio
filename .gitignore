# 비주얼 스튜디오 관련
.vs/
*.sln
*.vcxproj
*.filters
*.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# 관련 임시 폴더 제외
Binaries/
Intermediate/
DerivedDataCache/
Saved/
Build/

# Unreal asset files
*.uasset
*.umap
*.blend

# Build/package outputs
Build/
Builds/
Packaged/
Packages/
Windows/
WindowsNoEditor/
StagedBuilds/

# Logs / temp
*.log
*.tmp
*.cache

# OS files
.DS_Store
Thumbs.db

# 서버쪽 파일 예외
!Server/**/*.sln
!Server/**/*.vcxproj
!Server/**/*.vcxproj.filters
!Server/**/*.filters

# Mysql Third Party
!Server/MMORPG_GameServer/ThirdParty/mysql/**/*.lib
!Server/MMORPG_GameServer/ThirdParty/mysql/**/*.dll

# LoadTester 빌드 바이너리 (부하 생성기 배포용 — *.exe 무시에서 이 exe만 예외, pdb는 무시목록에 없어 그냥 추적됨)
!Server/LoadTester/LoadTester/x64/Release/LoadTester.exe
# Claude Code 로컬 설정 (AI 도구 흔적 — 저장소에 포함하지 않음)
.claude/
CLAUDE.md

# 삭제 대기 폴더
_to_delete/
